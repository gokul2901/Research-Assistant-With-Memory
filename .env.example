# Application Settings
APP_NAME="Research Assistant with Persistent Memory"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
API_V1_PREFIX="/api/v1"
SECRET_KEY="your-super-secret-key-change-me"
ALLOWED_ORIGINS=["*"]

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./data/chromadb"
CHROMA_COLLECTION_SOURCES="research_sources"
CHROMA_COLLECTION_CHUNKS="research_chunks"

# Embedding Configuration
EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# LiteLLM Multi-Model Router
PRIMARY_MODEL="gemini/gemini-1.5-flash"
FALLBACK_MODEL_1="zhipu/glm-4"
FALLBACK_MODEL_2="groq/llama-3.3-70b-versatile"

# API Keys
GEMINI_API_KEY="your-gemini-api-key"
ZHIPUAI_API_KEY="your-zhipu-glm-key"
GROQ_API_KEY="your-groq-key"
OPENAI_API_KEY=""

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Configuration
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.35
MAX_TOP_K=20

# n8n Automation & Webhook Integration
N8N_WEBHOOK_URL="https://gokuls2901.app.n8n.cloud/webhook/research-assistant/scrape"
N8N_CALLBACK_SECRET="production-n8n-secret-change-in-prod"

# Web Scraping & Ingestion
SCRAPER_USER_AGENT="ResearchAssistantBot/1.0"
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RETRIES=3
MAX_RESPONSE_SIZE_MB=10
MAX_CONTENT_LENGTH=1000000
MAX_REDIRECTS=5
MAX_CONCURRENT_SCRAPES=5

# PDF Export Settings
PDF_EXPORT_DIR="./data/exports"